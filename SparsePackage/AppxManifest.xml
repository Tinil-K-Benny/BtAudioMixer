<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse-package manifest for BtAudioMixer.
  Purpose: grants this unpackaged Win32/WPF exe a Package Identity so that
           Windows.Media.Audio.AudioPlaybackConnection.OpenAsync() succeeds.
           (That WinRT API is gated behind package identity and returns
           DeniedBySystem / 0x8007139F when called from an unpackaged process.)

  Registration — run once after every build, no elevation required:
    .\SparsePackage\Register-SparsePackage.ps1

  Unregistration / cleanup:
    .\SparsePackage\Unregister-SparsePackage.ps1

  How it works:
    Add-AppxPackage -Register <this file> -ExternalLocation <exe dir>
    tells Windows the exe lives outside the package store. Windows then
    stamps the process with a Package Identity when the exe launches, which
    satisfies the identity check inside AudioPlaybackConnection.OpenAsync().
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap10 rescap">

  <!--
    Publisher must be "CN=BtAudioMixer" — matches what Register-SparsePackage.ps1
    puts in the self-signed cert (only needed if you switch to the pack+sign path).
    For the -Register path used here no cert is required.
  -->
  <Identity
      Name="BtAudioMixer.SparsePackage"
      Publisher="CN=BtAudioMixer"
      Version="1.0.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Bluetooth Audio Mixer</DisplayName>
    <PublisherDisplayName>BtAudioMixer</PublisherDisplayName>
    <Description>Mixes phone Bluetooth audio with system audio and routes to earbuds.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
        Name="Windows.Desktop"
        MinVersion="10.0.19041.0"
        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!--
    runFullTrust: required for any desktop Win32 / WPF application.
    Without this the package activation model will refuse to launch the exe.
  -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>

  <Applications>
    <!--
      uap10:AllowExternalContent="true" tells Windows the exe is at ExternalLocation
      rather than inside a standard package-store folder. This attribute is what makes
      this a "sparse package with external location" rather than a full MSIX.
    -->
    <Application
        Id="BtAudioMixer"
        Executable="BtAudioMixer.exe"
        EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Bluetooth Audio Mixer"
          Description="Mixes phone Bluetooth audio with system audio."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

</Package>
