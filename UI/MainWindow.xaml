<Window x:Class="BtAudioMixer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluetooth Audio Mixer" Height="620" Width="560" MinWidth="480" MinHeight="560">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Phone (Bluetooth)" Grid.Row="0" Margin="0,0,0,8" Padding="8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PhoneDeviceCombo" Grid.Column="0" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                    <Button x:Name="ConnectPhoneButton" Grid.Column="1" Content="Connect" Width="90" Click="ConnectPhoneButton_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse x:Name="PhoneStatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PhoneStatusText" Text="Not connected" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Audio Sources" Grid.Row="1" Margin="0,0,0,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Phone lands on" VerticalAlignment="Center"/>
                <ComboBox x:Name="PhoneSourceCombo" Grid.Row="0" Grid.Column="1" Margin="0,3" DisplayMemberPath="Name"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="System audio device" VerticalAlignment="Center"/>
                <ComboBox x:Name="SystemSourceCombo" Grid.Row="1" Grid.Column="1" Margin="0,3" DisplayMemberPath="Name"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Output" Grid.Row="2" Margin="0,0,0,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="OutputCombo" Grid.Column="0" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="Refresh" Width="90" Click="RefreshDevicesButton_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Mixer" Grid.Row="3" Margin="0,0,0,8" Padding="8">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Phone volume" VerticalAlignment="Center"/>
                    <Slider x:Name="PhoneVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1.5" ValueChanged="PhoneVolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="PhoneVolumeLabel" Grid.Column="2" Text="100%" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="System volume" VerticalAlignment="Center"/>
                    <Slider x:Name="SystemVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1.5" ValueChanged="SystemVolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="SystemVolumeLabel" Grid.Column="2" Text="100%" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse x:Name="MixerStatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0"/>
                        <TextBlock x:Name="MixerStatusText" Text="Stopped" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="StartStopButton" Grid.Column="1" Content="Start Mixing" Width="120" Click="StartStopButton_Click"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Activity Log" Grid.Row="4">
            <TextBox x:Name="StatusText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#FFF5F5F5" FontFamily="Consolas" FontSize="11" Margin="4"/>
        </GroupBox>
    </Grid>
</Window>
